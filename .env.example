# Copy to .env and fill in. NEVER commit real values (.env is gitignored; this template is not).
# Grouped by REQUIRED (app won't boot without them) vs OPTIONAL. Var names/shape mirror the
# fail-fast schemas in packages/config/src/index.ts — keep the two in sync.

# ============================ REQUIRED ============================

# --- Database: Supabase Postgres + pgvector (dbEnv) ---
# Use the TRANSACTION-mode pooler (port 6543), NOT session mode (5432) — withTenant relies on it.
# DATABASE_URL is the OWNER/admin role (runs migrations). On managed Postgres this is usually a
# BYPASSRLS role (e.g. Supabase `postgres`), so it must NOT be what the app runtime connects as.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# APP_DATABASE_URL: the RUNTIME role — a NON-superuser, NON-BYPASSRLS role (e.g. falcon_app) so RLS
# actually enforces tenant isolation (R25/SC-003). If unset, the app falls back to DATABASE_URL
# (RLS may be bypassed — dev only). Create the role with scripts/setup-app-role.sql.
APP_DATABASE_URL=postgresql://falcon_app.PROJECTREF:PASSWORD@HOST:6543/postgres

# --- Redis (Upstash) for BullMQ (redisEnv) ---
# Use the TCP/ioredis URL (rediss://default:...@host.upstash.io:6379), NOT the https REST URL.
REDIS_URL=

# Optional: cap index-worker embedding fan-out on low-throughput embedding tiers (default 8).
# INDEX_CONCURRENCY=2

# --- LLM + embeddings (llmEnv); pinned models, see packages/llm ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Secrets store (secretsEnv); dedicated, NOT the app DB (R26) ---
# SECRETS_KEK is the base64 of a 32-byte key (createSecretStore throws if it isn't 32 bytes).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEK=

# --- Auth.js (authEnv + GitHub provider) ---
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth for sign-in. Auth.js reads these implicitly from env (providers: [GitHub] in
# apps/web/lib/auth.ts). Sign-in fails without them, so they ARE required despite not appearing
# in any Zod schema. Create an OAuth app (or reuse the GitHub App's client) for these.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth for sign-in — OPTIONAL. Lets pilot testers WITHOUT GitHub (non-engineers evaluating
# Decision Memory) sign in. The Google provider only turns on when BOTH are set (apps/web/lib/auth.ts).
# Create an OAuth client in Google Cloud Console; redirect URI: <AUTH_URL>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub App, repo-scoped (githubEnv) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG is Zod-optional but the /connect route returns 500 without it — set it if you
# want the "Connect GitHub" install flow to work (it's the app's URL slug: github.com/apps/<slug>).
GITHUB_APP_SLUG=

# ============================ OPTIONAL ============================

# --- Secrets backend selection (defaults to the dev file backend) ---
# SECRETS_BACKEND: "file" (default, dev) or "infisical". File path is kept OUTSIDE the app DB.
SECRETS_BACKEND=file
SECRETS_FILE_PATH=.secrets/store.enc.json
# Only when SECRETS_BACKEND=infisical:
INFISICAL_URL=
INFISICAL_TOKEN=

# --- Linear (linearEnv); needed for the Linear OAuth connect flow + webhook ---
# Register the OAuth app's redirect URI as: <your-web-origin>/api/integrations/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# HMAC signing secret from the Linear webhook config (verifies POST /api/webhooks/linear)
LINEAR_WEBHOOK_SECRET=

# --- Observability: Langfuse LLM-call logging (llmEnv) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Observability: Sentry (web + worker) + PostHog (web), via @falcon/observability ---
# All optional and no-op if unset. The SDKs (@sentry/node, posthog-node) are dynamically loaded
# only when the key is present — install them in the prod images where you enable these.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
