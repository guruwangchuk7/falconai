# Copy to .env and fill in. NEVER commit real values (.env is gitignored; this template is not).

# --- Database: Supabase Postgres + pgvector ---
# Use the TRANSACTION-mode pooler (port 6543), NOT session mode (5432) — withTenant relies on it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# --- Redis (Upstash) for BullMQ ---
REDIS_URL=

# --- GitHub App (repo-scoped) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Linear / Jira ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- LLM + embeddings (pinned models; see packages/llm) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Secrets store (dedicated; per R26 this is NOT the app DB) ---
SECRETS_STORE_URL=
SECRETS_STORE_TOKEN=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# --- Auth.js ---
AUTH_SECRET=
